<!-- views/layouts/main.hbs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <!-- [Existing head content here] -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Param Singh Virdi's Store</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/main.css" />
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">WEB322 - Assignment 5 - Param Singh Virdi</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"             aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
    
            <div class="collapse navbar-collapse" id="navbarContent">
                <!-- Left Side Links -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    {{#navLink "/about"}}About{{/navLink}}
                    {{#navLink "/shop"}}Shop{{/navLink}}
                    {{#navLink "/categories"}}Categories{{/navLink}}
                    {{#navLink "/items"}}Items{{/navLink}}
                </ul>
    
                <!-- Right Side Links -->
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    {{#if session.user}}
                        <li class="nav-item">
                            <a class="nav-link" href="/userHistory">User History</a>
                        </li>
                        <li class="nav-item">
                            <span class="navbar-text me-2">Hello, {{session.user.userName}}</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/logout">Logout</a>
                        </li>
                    {{else}}
                        <li class="nav-item">
                            <a class="nav-link" href="/register">Register</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/login">Login</a>
                        </li>
                    {{/if}}
                </ul>
            </div>
        </div>
    </nav>
    
    <!-- Main Content -->
    <div class="container my-4">
        {{{body}}}
    </div>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
